{
  "name": "ai-gateway-edgeone",
  "version": "1.0.0",
  "type": "module",
  "main": "cloud-functions/[[default]].js",
  "scripts": {
    "build": "npm run build:bundle",
    "build:bundle": "node scripts/prebuild.mjs && node scripts/build-bundle.mjs",
    "dev": "PAGES_SOURCE=skills npx edgeone makers dev",
    "deploy": "npm run build && PAGES_SOURCE=skills npx edgeone makers deploy --json",
    "verify": "node scripts/verify-deploy.mjs",
    "deploy:verify": "npm run deploy && npm run verify"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.17",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "edgeone": "^1.6.41",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
